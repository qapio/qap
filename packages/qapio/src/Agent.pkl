import "package://pkg.pkl-lang.org/pkl-pantry/org.openapis.v3.contrib@1.1.0#/SchemaGenerator.pkl"
import "package://pkg.pkl-lang.org/pkl-pantry/org.openapis.v3@2.2.0#/Schema.pkl"

class AgentInstruction {
  Role: Listing<String>
  Task: Listing<String>
  Format: Listing<String>
  Guardrails: Listing<String>
}

class AgentOptions {
  Instructions: String?
  Role: String?
  Tasks: Listing<Task>
  Format: String?
  Guardrails: Listing<Guardrail>
  Exemplars: Listing<Exemplar>
  Tone: String?
  ResponseFormat: Schema?
  Profile: Profile?
}

class Profile {
  Title: String?
  FirstName: String?
  LastName: String?
  AvatarUrl: String?
  Nickname: String?
  Email: String?
  Phone: String?
  WebsiteUrl: String?
}

open class Entry {
  Name: String
  Description: String
  Value: String
}

class Task extends Entry {

}

class Exemplar extends Entry {

}

class Guardrail extends Entry {

}


class AgentBuilder {
  Instructions: String?
  Role: String
  Tasks: Listing<Task>
  Format: String
  Guardrails: Listing<Guardrail>
  Exemplars: Listing<Exemplar>
  Tone: String?
  ResponseFormat: Schema?
  Profile: Profile?

  function WithRole(role: String): AgentBuilder = (this) {
    Role = role
  }

  function WithTone(tone: String): AgentBuilder = (this) {
    Tone = tone
  }

  function AddTask(task: Task): AgentBuilder = (this) {
    Tasks = outer.Tasks.toList().add(task).toListing()
  }

  function WithFormat(format: String): AgentBuilder = (this) {
    Format = format
  }

  function AddExemplar(exemplar: Exemplar): AgentBuilder = (this) {
    Exemplars = outer.Exemplars.toList().add(exemplar).toListing()
  }

  function AddGuardrail(guardrail: Guardrail): AgentBuilder = (this) {
    Guardrails = outer.Guardrails.toList().add(guardrail).toListing()
  }

  function WithProfile(profile: Profile): AgentBuilder = (this) {
    Profile = profile
  }

  function WithResponseFormat(responseFormat: Class): AgentBuilder = (this) {
    ResponseFormat = SchemaGenerator.generate(responseFormat)
  }
}

function Create() = new AgentBuilder {

}

function FromInstuction(instruction: String) = new AgentBuilder {
  Instructions = instruction
}

