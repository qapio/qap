import "package://pkg.pkl-lang.org/pkl-pantry/org.openapis.v3.contrib@1.1.0#/SchemaGenerator.pkl"
import "package://pkg.pkl-lang.org/pkl-pantry/org.openapis.v3@2.2.0#/Schema.pkl"

class AgentInstruction {
  Role: Listing<String>
  Task: Listing<String>
  Format: Listing<String>
  Guardrails: Listing<String>
}


class Profile {
  Title: String?
  FirstName: String?
  LastName: String?
  AvatarUrl: String?
  Nickname: String?
  Email: String?
  Phone: String?
  WebsiteUrl: String?
}

open class Entry {
  Name: String
  Description: String
  Value: String
}

class Task extends Entry {

}

class Exemplar extends Entry {

}

class Guardrail extends Entry {

}

class ResourceItem extends Entry {

}

class ChatClient {
  Endpoint: String
  Model: String?
}

class ChatClientAgent {
  Options: AgentOptions
  ChatClient: ChatClient
}

class AgentOptions {
  Instructions: String?
  Role: String?
  Tasks: Listing<Task>
  Format: String?
  Guardrails: Listing<Guardrail>
  Exemplars: Listing<Exemplar>
  Resources: Listing<ResourceItem>
  Tone: String?
  ResponseFormat: Schema?
  Profile: Profile?
  ContextProviders: Listing<String>

  function WithRole(role: String): AgentOptions = (this) {
    Role = role
  }

  function WithTone(tone: String): AgentOptions = (this) {
    Tone = tone
  }

  function AddTask(task: Task): AgentOptions = (this) {
    Tasks = outer.Tasks.toList().add(task).toListing()
  }

  function AddTasks(tasks: Listing<Task>): AgentOptions = (this) {
    Tasks = new Listing<Task> {
      ...outer.Tasks
      ...tasks
    }
  }

  function AddContextProvider(endpoint: String): AgentOptions = (this) {
    ContextProviders = outer.ContextProviders.toList().add(endpoint).toListing()
  }

  function AddContextProviders(endpoints: Listing<String>): AgentOptions = (this) {
    ContextProviders = new Listing<String> {
      ...outer.ContextProviders
      ...endpoints
    }
  }

  function AddResource(resource: ResourceItem): AgentOptions = (this) {
    Resources = outer.Resources.toList().add(resource).toListing()
  }

  function AddResources(resources: Listing<ResourceItem>): AgentOptions = (this) {
    Resources = new Listing<ResourceItem> {
      ...outer.Resources
      ...resources
    }
  }

  function WithFormat(format: String): AgentOptions = (this) {
    Format = format
  }

  function AddExemplar(exemplar: Exemplar): AgentOptions = (this) {
    Exemplars = outer.Exemplars.toList().add(exemplar).toListing()
  }


  function AddExemplars(exemplars: Listing<Exemplar>): AgentOptions = (this) {
    Exemplars = new Listing<Exemplar> {
      ...outer.Exemplars
      ...exemplars
    }
  }

  function AddGuardrail(guardrail: Guardrail): AgentOptions = (this) {
    Guardrails = outer.Guardrails.toList().add(guardrail).toListing()
  }

  function AddGuardrails(guardrails: Listing<Guardrail>): AgentOptions = (this) {
    Guardrails = new Listing<Guardrail> {
      ...outer.Guardrails
      ...guardrails
    }
  }

  function WithProfile(profile: Profile): AgentOptions = (this) {
    Profile = profile
  }

  function WithResponseFormat(responseFormat: Class): AgentOptions = (this) {
    ResponseFormat = SchemaGenerator.generate(responseFormat)
  }
}

function CreateOptions() = new AgentOptions {

}

function CreateInstruction(instruction: String) = new AgentOptions {
  Instructions = instruction
}

