open module Tdip.Qapio.Assistant.SlackGateway

extends "Qaplet.pkl"
import "Qaplet.pkl"
import "FlowStage.pkl"

class ClientOptions {
  Endpoint: String
  Model: String?
}

Token: String
Endpoint: String
Client: ClientOptions

function Send(chat: String): FlowStage.FlowStage =
  new {
    Endpoint = module.Id
    Qapi = "SendMessage"
    Props = new Dynamic {
      Chat = chat
    }
  }

function Create(endpoint: Module, token: String, opts: ClientOptions): Qaplet.Qap =
  new {
    Id = "SlackGateway"
    Module = "Tdip.Qapio.Assistant.SlackGateway"
    Props = new Dynamic {
      Endpoint = endpoint.getProperty("Id")
      Token = token
      Client = opts
    }
  }