open module Tdip.Qapio.Ollama.Client

extends "Qaplet.pkl"
import "Agent.pkl"
import "FlowStage.pkl"
import "SourceStage.pkl"

Uri: String
Model: String?

function AsChatClientAgent(options: Agent.AgentOptions): Agent.ChatClientAgent =
  new {
    ChatClient = new {
      Endpoint = module.Id
      Model = module.Model
    }
    Options = options
  }

function Create(agent: Agent | String): FlowStage.FlowStage =
  new FlowStage.FlowStage {
    Endpoint = module.Id
    Qapi = "CreateChatClientAgent"
    Args = if (agent is Agent) new Listing { agent.Id } else new Listing { agent }
  }

function GetResponse(message: String): SourceStage.SourceStage =
  new SourceStage.SourceStage {
    Endpoint = module.Id
    Qapi = "CreateResponse"
    Args = new Listing { message }
  }