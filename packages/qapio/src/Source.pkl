open module Tdip.Qapio.Stages.Source.SourceStage

extends "Qaplet.pkl"

import "SourceStage.pkl" as QapiModule

typealias SourceStage = QapiModule.SourceStage

function Tick(interval: Int): SourceStage =
  From(new SourceStage {
    Endpoint = "Source"
    Qapi = "Tick"
    Args = new Listing { new Dynamic {
      Interval = interval
    }
  }})

function FromCron(cron: String): SourceStage =
  From(new SourceStage {
    Endpoint = "Source"
    Qapi = "FromCron"
    Args = new Listing { new Dynamic {
      Expression = cron
    }
  }})

function CombineLatest(sources: Listing<SourceStage>): SourceStage =
  From(new SourceStage {
    Endpoint = "Source"
    Qapi = "CombineLatest"
    Args = new Listing { new Dynamic {
      Expressions = sources
    }
  }})

function FromExpression(expression: String): SourceStage =
  From(new SourceStage {
    Endpoint = "Source"
    Qapi = "FromExpression"
    Args = new Listing { expression }
  })

function From(stage: SourceStage): SourceStage =
  if (stage is SourceStage)
    stage
  else
    new SourceStage {
      Endpoint = stage.Endpoint
      Kind = "Source"
      Qapi = stage.Qapi
      Args = stage.Args
    }

function Single(value: Any): SourceStage =
  From(new SourceStage {
    Endpoint = "Source"
    Qapi = "Single"
    Args = new Listing { value }
  })

function FromAction(type: String, payload: Any): SourceStage =
  From(new SourceStage {
    Endpoint = "Source"
    Qapi = "FromAction"
    Args = new Listing { new Dynamic {
      Type = type
      Payload = payload
    }
  }})

open class Action {
  Type: String
  Payload: Any = new Dynamic {

  }
}


Qapi: SourceStage
