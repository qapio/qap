import "Qapi.pkl"

typealias Operator = Qapi.Operator

class FlowStage extends Qapi.Stage {
  Kind = "Flow"
  function AddOperation(name: String, props: Listing<Any>): FlowStage =
    (this) {Operators = super.Operators.toList().add(new Operator {Qapi = name Args = props}).toListing()}


  function Take(count: Int): FlowStage =
    AddOperation("Take", new Listing { new Dynamic {
      Count = count
    }})

  function AsChatResponse(): FlowStage =
    AddOperation("AsChatResponse",  new Listing { new Dynamic {

    }})

  function WithApproval(): FlowStage =
    AddOperation("WithApproval",new Listing { new Dynamic {

    }})

  function Select(lambda: String): FlowStage =
    AddOperation("Select",new Listing { new Dynamic {
      Expression = lambda
    }})

  function Skip(count: Int): FlowStage =
    AddOperation("Skip",new Listing { new Dynamic {
      Count = count
    }})

  function Via(stage: FlowStage | String): FlowStage =

    if (stage is String)
      AddOperation("Via", new Listing {new Dynamic {
        Expression = stage
      }})
    else
      AddOperation("Via",new Listing { stage})

  function Where(lambda: String): FlowStage =
    AddOperation("Where", new Listing {new Dynamic {
      Expression = lambda
    }})
}