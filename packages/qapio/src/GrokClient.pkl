open module Tdip.Qapio.Grok.Client

extends "Qaplet.pkl"
import "Agent.pkl"
import "FlowStage.pkl"
import "SourceStage.pkl"
import "package://pkg.pkl-lang.org/pkl-pantry/org.openapis.v3.contrib@1.1.0#/SchemaGenerator.pkl"

ApiToken: String
Model: String?

class AgentProps {
  Instructions: String
  ResponseFormat: Class?
  ContextProviders: Listing<String>
  ApprovalFlow: FlowStage.FlowStage?
}

function AsAgent(agent: AgentProps): FlowStage.FlowStage =
  new FlowStage.FlowStage {
    Endpoint = module.Id
    Qapi = "CreateChatAgent"
    Args = new Listing {
      new Dynamic {
        Instructions = agent.Instructions
        ApprovalFlow = agent.ApprovalFlow
        ResponseFormat = if (agent.ResponseFormat != null) SchemaGenerator.generate(agent.ResponseFormat) else null
        ContextProviders = agent.ContextProviders
      }
    }
  }

function GetResponse(message: String): SourceStage.SourceStage =
  new SourceStage.SourceStage {
    Endpoint = module.Id
    Qapi = "CreateResponse"
    Args = new Listing { message }
  }