open module Tdip.Qapio.Grok.Client

extends "Qaplet.pkl"
import "Agent.pkl"
import "FlowStage.pkl"
import "SourceStage.pkl"

ApiToken: String
Model: String?

class AgentProps {
  Instructions: String
  ResponseFormat: Class?
  ContextProviders: Listing<String>
  ApprovalFlow: FlowStage.FlowStage?
}

function AsAgent(agent: AgentProps): FlowStage.FlowStage =
  new FlowStage.FlowStage {
    Endpoint = module.Id
    Qapi = "CreateChatAgent"
    Args = new Listing { agent }
  }

function GetResponse(message: String): SourceStage.SourceStage =
  new SourceStage.SourceStage {
    Endpoint = module.Id
    Qapi = "CreateResponse"
    Args = new Listing { message }
  }