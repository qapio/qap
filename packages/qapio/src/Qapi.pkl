open class QapiBase {
  Qapi: String
  Args: Listing<Any>
}
open class Qapi extends QapiBase {
  Endpoint: String
}

open class Stage extends Qapi {
  Kind: "Source" | "Flow" | "Sink" | "RunnableGraph"
  Operators: Listing<Operator>
  Middlewares: Listing<Stage>
}



open class Operator extends QapiBase {

}
