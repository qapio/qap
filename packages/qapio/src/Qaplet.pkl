open module Tdip.Qapio.Qaplet
import "pkl:reflect"
import "SourceStage.pkl"

open class Qap {
  Id: String
  Module: String
  Props: Any
}


class ContextData {
  Name: String?
  Description: String?
  Instructions: String?
  Providers: Listing<String>
  Resources: Listing<Resource>
  PreStart: Listing<SourceStage.SourceStage>
  Extensions: Listing<Qap>
}

Id: String = reflect.Module(module).name
Context: ContextData = new ContextData {

}

function Identify(): SourceStage.SourceStage =
  new {
    Endpoint = "\(module.Id).Qap"
    Qapi = "Identify"
    Props = new Dynamic {

    }
  }

function Uri(fileName: String): Uri = read(fileName).uri