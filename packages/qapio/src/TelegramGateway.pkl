open module Tdip.Qapio.Telegram.Gateway

extends "Qaplet.pkl"
import "Qaplet.pkl"
import "FlowStage.pkl"
import "SourceStage.pkl"
import "Qapi.pkl"
import "Source.pkl"

class ClientOptions {
  Endpoint: String
  Model: String?
}

class Account {
  Id: String
}

class Command {
  Name: String
  Description: String
  Command: SourceStage.SourceStage
  Trigger: SourceStage.SourceStage?
}

Token: String
Endpoint: String?
Client: ClientOptions
Users: Listing<Account>
Commands: Listing<Command>


function Broadcast(message: Any): FlowStage.FlowStage =
  new {
    Endpoint = module.Id
    Qapi = "Broadcast"
    Props = message
  }

function Send(chat: String): FlowStage.FlowStage =
  new {
    Endpoint = module.Id
    Qapi = "SendMessage"
    Props = new Dynamic {
      Chat = chat
    }
  }

function GetTranscript(userId: String): SourceStage.SourceStage =
  new {
    Endpoint = "\(module.Id).Chat_\(userId)"
    Qapi = "ChatTranscript"
    Props = new Dynamic {

    }
  }

function Create(endpoint: Module, token: String, opts: ClientOptions): Qaplet.Qap =
  new {
    Id = "TelegramGateway"
    Module = "Tdip.Qapio.Assistant.TelegramGateway"
    Props = new Dynamic {
      Endpoint = endpoint.getProperty("Id")
      Token = token
      Client = opts
    }
  }